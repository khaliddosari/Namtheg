# Backend origin the /api/backend/* proxy forwards to (see next.config.ts).
# Local dev: the local FastAPI server.
# On Vercel: set this to the Modal backend's public URL, e.g.
#   https://<your-modal-workspace>--namtheg-backend-fastapi-app.modal.run
BACKEND_URL=http://localhost:8000

# Canonical site URL used for metadata / Open Graph tags (og:image is resolved
# against it, so it must be a domain that actually serves this app).
# Optional: defaults to https://namtheg.khalid-ai.dev.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
