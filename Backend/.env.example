# Primary LLM: GPT-6 Sol, called directly on OpenAI's Responses API.
OPENAI_API_KEY=
LLM_PRIMARY_MODEL=gpt-6-sol
# none | low | medium | high | xhigh | max  (higher = slower and pricier)
LLM_PRIMARY_REASONING_EFFORT=medium

# Fallback LLM: DeepSeek V4 Flash via OpenRouter. Used when the primary is
# unset or fails; a run that falls back stays on the fallback until it ends.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional OpenRouter attribution headers (shown on the OpenRouter dashboard).
OPENROUTER_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=Namtheg

# Where the analyst agent's code runs:
#   modal - Modal Sandbox (gVisor, no network). Production default.
#   local - plain subprocess on this machine. NOT isolated; dev/tests only.
#   none  - agent reviews the profile/audit without running code.
SANDBOX_BACKEND=modal
# Analyst budget per run: code executions, and total seconds.
AGENT_MAX_TOOL_CALLS=12
AGENT_TIME_BUDGET_SECONDS=240

# Training runs only on the H200 GPU service (app/training/gpu_app.py; deploy
# it with `modal deploy app/training/gpu_app.py`). Hyperparameter search stops
# at whichever limit comes first. TUNING_TRIALS counts full cross-validation
# checks: a trial stopped after one of five folds uses a fifth of one.
TUNING_TRIALS=20
TUNING_TIMEOUT_SECONDS=300
# Each model group starts no new work after this many seconds, then fits its
# best model; a group still running 5 minutes later is stopped.
TRAINING_BUDGET_SECONDS=900

# Cloudflare R2 (optional). With all four set, run artifacts are mirrored to
# the bucket, restored from it when missing locally, and downloads are served
# as presigned URLs that expire after R2_URL_TTL_SECONDS. Create an R2 API
# token with Object Read & Write on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=
R2_URL_TTL_SECONDS=900

# Optional accounts: name and email, no passwords; every sign-in and sign-up is
# confirmed with a 6-digit code by email. Off (no sign-in button) unless
# AUTH_SECRET is set and email can be sent. Generate the secret with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out; accounts and their runs are kept.
AUTH_SECRET=
# Codes are emails; this caps them per day to protect the sender's quota.
AUTH_MAX_CODES_PER_DAY=100
# Any SMTP provider. Resend: host smtp.resend.com, port 465, username "resend",
# password = an API key, from = an address on a domain verified in Resend.
# Gmail: host smtp.gmail.com, port 465, username = the address, password = an
# app password (needs 2-step verification).
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Local machine only: write codes to the server log instead of sending them.
# Never set this in production.
AUTH_DEV_LOG_CODES=false

STORAGE_DIR=./storage
LOG_LEVEL=INFO

# Modal — required for the "Deploy" button. Set MODAL_WORKSPACE to your
# Modal username (visible in `modal app list` output). The inference app and
# volume names below match app/deploy/inference_app.py defaults — only change
# them if you've renamed the app or volume.
MODAL_WORKSPACE=
MODAL_INFERENCE_APP=modelforge-inference
MODAL_MODELS_VOLUME=modelforge-models
